# =========================================================================
# Variáveis de ambiente — Sistema de Locação ACIMM (CLAUDE.md §3)
# NENHUM valor real neste arquivo. Copie para `.env.local` e preencha.
# Em produção, configurar como Environment Variables na Vercel.
# =========================================================================

# ---- Supabase (públicas) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (server only) ----
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
APP_URL=http://localhost:3000

# ---- Cron / segurança (server only) ----
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=

# ---- Sophus — validação de associado (server only) ----
SOPHUS_CLIENT_ID=
SOPHUS_CLIENT_SECRET=

# ---- Sympla — eventos internos (server only) ----
SYMPLA_API_TOKEN=

# ---- Autentique — assinatura digital (server only) ----
AUTENTIQUE_API_TOKEN=

# ---- Evolution API — WhatsApp (server only) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- Resend — e-mail (server only) ----
RESEND_API_KEY=

# ---- Google Calendar OAuth (server only) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
